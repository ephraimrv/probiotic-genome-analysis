# Genome data and annotator output are excluded from version control. The
# archived record is the code and the derived tables; sequence data belongs in
# a sequence archive under its own accession, not in a software DOI.
data/raw/**
!data/raw/README.md
# A negated rule cannot re-include a file beneath an excluded directory, so
# the strain directories are re-included before their READMEs are. Without
# these two lines a per-strain README is silently untracked.
!data/raw/*/
!data/raw/*/README.md
data/annotation/**
!data/annotation/README.md
data/interim/*
!data/interim/uniprot_domains.json

# Results that are regenerated by the pipeline are nevertheless committed:
# figures and tables are the citable content of this repository.

# QC output: the tool dumps are large and are not the citable content of this
# repository. The summary files that the manuscript quotes are kept, together
# with the recorded tool versions.
results/qc/**
!results/qc/versions.txt
!results/qc/fastani_S1A.tsv
!results/qc/ref_list.txt
!results/qc/quast/
!results/qc/quast/report.tsv
!results/qc/checkm2/
!results/qc/checkm2/quality_report.tsv

# Files held for review and never committed
scripts/proposed/
*_PROPOSED.*

# Caches and environments
__pycache__/
*.pyc
# pytest, mypy and ruff write their own .gitignore into their cache directories,
# so those need no rule here.
.Rproj.user/
.Rhistory
.RData
renv/library/
renv/staging/
.venv/
.ipynb_checkpoints/

# Operating-system metadata
.DS_Store
Thumbs.db
desktop.ini

# Local working documents, deliberately not published
RELEASE.md
